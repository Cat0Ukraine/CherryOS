#!/usr/bin/env bash
# 🍒 CherryOS Auto-Flasher via mpremote (Linux) 🍒

set -e

SRC_DIR="${SRC_DIR:-$HOME/Projects/MicroPython/CherryOS}"
FILES=("CherryOS.py" "kernel.py" "main.py" "CherryAPI.py")

echo "============================================="
echo "🍒 CherryOS Auto-Flasher via mpremote 🍒"
echo "============================================="

if ! command -v mpremote >/dev/null 2>&1; then
    echo "❌ mpremote not found. Install it: pip install mpremote"
    exit 1
fi

if ! mpremote connect list >/dev/null 2>&1; then
    echo "❌ Error: Raspberry Pi Pico not found!"
    echo "Check the USB connection (and /dev/ttyACM* permissions if needed - sudo usermod -aG dialout \$USER)"
    exit 1
fi

echo "⏳ Copying files to the board..."
echo "---------------------------------------------"

i=1
total=${#FILES[@]}
for file in "${FILES[@]}"; do
    echo "📦 [$i/$total] Copying $file..."
    if mpremote cp "$SRC_DIR/$file" ":$file"; then
        echo "✅ Done!"
    else
        echo "❌ Failed to copy $file"
        exit 1
    fi
    i=$((i + 1))
done

echo "---------------------------------------------"
echo "🚀 All files uploaded successfully!"
echo "🔄 Syncing time and restarting main.py..."

mpremote rtc --set + run "$SRC_DIR/main.py"

echo "✨ Done! CherryOS is running."
echo "============================================="